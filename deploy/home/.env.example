# OpenMMO home server settings. setup.ps1 copies this to .env and fills in every secret marked
# "generated"; a re-run of setup.ps1 never changes a value that is already set.
# Keep .env private: it holds the database passwords and the admin password.

# --- image -------------------------------------------------------------------------------------
# Image tag to run; setup.ps1 / update.ps1 set it from the image tar they load.
OPENMMO_VERSION=

# --- databases (generated) ---------------------------------------------------------------------
LOGIN_DB_NAME=openmmo_login_db
LOGIN_DB_USER=openmmo_login_user
LOGIN_DB_PASSWORD=
GAME_DB_NAME=openmmo_game_db
GAME_DB_USER=openmmo_game_user
GAME_DB_PASSWORD=

# --- servers -----------------------------------------------------------------------------------
# Shared by login and game to sign session and remember-me tokens (generated, 48+ chars).
# Changing it logs everybody out.
OPENMMO_SESSION_SECRET=
# First account, created only while the database has no user at all; it is a game admin.
# The password is generated; change it in-game is not possible, so keep it in your password manager.
OPENMMO_ADMIN_USERNAME=admin
OPENMMO_ADMIN_PASSWORD=
# Login user ids whose characters get admin rights (comma separated). 1 = the account above.
OPENMMO_ADMIN_USER_IDS=1
# Time zone for log lines, e.g. Asia/Shanghai.
TZ=UTC

# --- local play --------------------------------------------------------------------------------
# The game is also at http://127.0.0.1:<LOCAL_PORT>/ on this PC (never on the LAN).
LOCAL_PORT=8080

# --- Pinggy tunnel -----------------------------------------------------------------------------
# on = public https URL through Pinggy; off = only http://127.0.0.1:LOCAL_PORT on this PC.
TUNNEL=on
# Your Pinggy Pro token (dashboard.pinggy.io -> Tokens). Empty = free tier: random URL that
# changes on every reconnect and a 60 minute limit. Never printed in the logs.
PINGGY_TOKEN=
# The persistent domain bound to that token in the Pinggy dashboard, without https://
# (e.g. mymon.a.pinggy.link). Empty = whatever URL Pinggy hands out (see logs.ps1 tunnel).
PINGGY_SUBDOMAIN=
# Site-wide HTTP basic auth at Pinggy, before anyone even sees the login page (generated).
# Letters, digits, '.', '_' and '-' only. Clear BOTH to switch it off (invite codes still apply).
SITE_USER=friends
SITE_PASS=
# Only these IPs / CIDRs may open the site (comma separated). Empty = anyone with the URL.
PINGGY_ALLOW_IPS=
# Advanced: Pinggy server and extra '+' separated Pinggy keywords.
PINGGY_SERVER=
PINGGY_EXTRA_OPTIONS=
# Advanced: browser origins the gateway accepts for the game WebSocket, comma separated.
# Empty = https://PINGGY_SUBDOMAIN when set, else any *.a.pinggy.link / *.a.free.pinggy.link.
GATEWAY_ALLOW_ORIGIN=
# 1 = the tunnel container only prints its SSH command (token redacted) and stops.
TUNNEL_DRY_RUN=0
