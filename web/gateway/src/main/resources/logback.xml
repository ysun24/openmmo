<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="io.netty" level="WARN" />
  <!-- One client per socket logs every packet it ignores; keep the gateway log readable. -->
  <logger name="de.fiereu.openmmo.client" level="INFO" />
  <logger name="de.fiereu.network" level="INFO" />
  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
